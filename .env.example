# Admin authentication
ADMIN_PASSWORD=change-this-secure-password-123

# Optional: key used to sign admin session cookies (defaults to ADMIN_PASSWORD).
# Set a long random value so sessions can be revoked by rotating it.
ADMIN_SESSION_SECRET=

# Site URL (update for production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable GA.
NEXT_PUBLIC_GA_ID=

# Turso Database
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token
